# ─── Base de données (PostgreSQL : Supabase, Neon, ou serveur local) ───
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/configurateur

# ─── URL publique du site (sans / final) ───
SITE_URL=https://configurateur.forestar.be

# ─── Administration ───
ADMIN_PASSWORD=changez-moi
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -hex 32)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# ─── Votre société (apparaît sur le site, les e-mails et les PDF) ───
COMPANY_NAME="Forestar"
COMPANY_ADDRESS="Chaussée d'Ecaussinnes 162, 7090 Braine-le-Comte"
COMPANY_PHONE="+32 67 83 07 06"
COMPANY_EMAIL="info@forestar.be"
COMPANY_VAT=""
COMPANY_IBAN=""
# Couleur principale de la marque (hexadécimal)
BRAND_COLOR=#e9b500
# Préfixe des numéros de devis (ex. VC → VC-2026-0001)
QUOTE_PREFIX=FS
QUOTE_VALIDITY_DAYS=30

# ─── E-mails (SMTP : Resend, Brevo, OVH, Gmail Workspace…) ───
# Laisser vide en développement : les e-mails sont alors affichés dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Forestar <devis@forestar.be>"
# Adresse(s) qui reçoivent les nouvelles demandes (séparées par des virgules)
DEALER_NOTIFY_EMAILS=info@forestar.be

# ─── Stockage des fichiers (photos, brochures, 360°, 3D) ───
# Vide = dossier UPLOAD_DIR (défaut : ./uploads) du serveur (VPS, Docker).
# Sur Vercel, renseignez Supabase Storage (bucket public « medias »).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=medias
UPLOAD_DIR=
